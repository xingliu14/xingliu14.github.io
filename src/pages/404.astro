---
// Not Found, the way Apache said it, with a way back: a search form, the newest posts and the
// archive. GitHub Pages serves this file at any missing address, so every link here but the
// skip link is root-relative. site.js names the missing path, fills in the search from it, and suggests the post
// it probably meant.
import ArchiveList from "../components/ArchiveList.astro";
import SearchForm from "../components/SearchForm.astro";
import Base from "../layouts/Base.astro";
import { buildDate, later } from "../lib/dates";
import { pathsLastModified } from "../lib/last-modified.mjs";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
const lastModified = later(pathsLastModified(["src/pages/404.astro"]) ?? { date: buildDate(), iso: null }, { date: posts[0]?.date ?? "", iso: null });
---

<Base
  title="Not Found — Xing Liu"
  description="This page does not exist on xingliu.me. Search the posts or start from the archive."
  path="/404.html"
  current="404"
  noindex
  footerSearch={false}
  lastModified={lastModified}
>
<h1>Not Found</h1>
<p id="missing">The requested URL was not found on this server.</p>
<p class="didyoumean" id="didyoumean" hidden></p>
<p>Perhaps it moved, or the link has a typo. One of these may help:</p>
<SearchForm variant="404" />
<h2 id="newest">The five newest posts</h2>
<ArchiveList posts={posts.slice(0, 5)} brief />
<p>Or start again from the <a href="/">home page</a> or the <a href="/writing/">Writing archive</a>.</p>
<hr>
<address class="server">GitHub Pages server at xingliu.me Port 443</address>
</Base>
