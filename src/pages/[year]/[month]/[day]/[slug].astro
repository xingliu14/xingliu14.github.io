---
// A post, at the address Jekyll gave it: /YYYY/MM/DD/slug/, case kept. The article body comes from
// the Markdown pipeline (src/lib/markdown.mjs) with its contents box, section numbers and back links
// already in place; this page adds the header, the share box and the way to older and newer posts.
import { render } from "astro:content";
import Byline from "../../../../components/Byline.astro";
import ColoursSelect from "../../../../components/ColoursSelect.astro";
import Pager from "../../../../components/Pager.astro";
import Share from "../../../../components/Share.astro";
import Base from "../../../../layouts/Base.astro";
import { getPosts, type Post } from "../../../../lib/posts";
import { postJsonLd } from "../../../../lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so the next-older post follows each one in the list.
  return posts.map((post, i) => ({
    params: { year: post.year, month: post.month, day: post.day, slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post.entry);
// WebKit breaks "侦探小说：He’s Replaceable" inside the English words. A short Latin subtitle after a
// full-width colon is kept on one line, and the title may break after the colon instead.
const subtitle = /^(.+：)([^\p{Script=Han}：]{1,24})$/u.exec(post.title);
---

<Base
  title={`${post.title} — Xing Liu`}
  ogTitle={post.title}
  description={post.description}
  path={post.url}
  lang={post.lang}
  current="post"
  section="writing"
  ogType="article"
  ogKey={post.id}
  jsonld={postJsonLd(post)}
  lastModified={post.lastModified}
  article={{ published: post.date, modified: post.modified?.iso ?? null, section: post.topic.name }}
>
<article class="post" lang={post.zh ? "zh-CN" : undefined}>
<header class="post-head">
<p class="crumbs" lang="en"><a href="/">Xing Liu’s Home Page</a> › <a href="/writing/">Writing</a> › <a href={`/writing/#y${post.year}`}>{post.year}</a></p>
<h1>{subtitle ? <Fragment>{subtitle[1]}<wbr><span class="nowrap">{subtitle[2]}</span></Fragment> : post.title}</h1>
<Byline post={post} />
{post.minutes >= 10 && <Fragment><p class="colours-line" lang="en"><label for="colours-top">Page colors:</label> <ColoursSelect id="colours-top" /></p>{"\n"}</Fragment>}</header>
<div class={post.topic.id === "fiction" ? "article fiction" : "article"}>
<Content />
</div>
<p class="end" aria-hidden="true">* * *</p>
<p class="print-url" lang="en">{new URL(post.url, Astro.site).href}</p>
</article>
<hr>
<Share post={post} />
<hr>
<Pager older={older} newer={newer} />
</Base>
