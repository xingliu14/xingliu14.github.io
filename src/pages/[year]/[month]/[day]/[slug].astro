---
import { render } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import Masthead from "../../../../components/Masthead.astro";
import Octicon from "../../../../components/Octicon.astro";
import { formatDate, getPosts, type Post } from "../../../../lib/posts";
import { getSocialAccounts } from "../../../../lib/social";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { year: post.year, month: post.month, day: post.day, slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, lang } = post.entry.data;
const { Content } = await render(post.entry);
const pageUrl = new URL(post.url, Astro.site).href;
const shareServices = getSocialAccounts()
  .map(({ service }) => service)
  .filter((service) => service.share_url_prefix);
---

<Base title={title} description={post.description} lang={lang}>
  <div class="post-container" data-layout="sidebar">
    <div class="split-layout">
      <aside class="sidebar bg-gray-dark" lang="en">
        <Masthead metadata />
      </aside>

      <main class="main-content">
        <div class="content-wrapper animate-fade-in">
          <article class="post-card">
            <div class="content-nav" lang="en">
              <a href="/" class="nav-link">
                <Octicon name="chevron-left" class="nav-icon" fill="var(--color-accent, #2563eb)" label="Home" />
                <span>Home</span>
              </a>
            </div>

            <header class="post-header">
              <h1 class="post-title">{title}</h1>
              <div class="post-meta" lang="en">
                <time datetime={`${post.year}-${post.month}-${post.day}T00:00:00+00:00`}>
                  <Octicon name="calendar" class="meta-icon" />
                  {formatDate(post)}
                </time>
              </div>
            </header>

            <div class="article-content">
              {
                shareServices.length > 0 && (
                  <div class="share-widget" lang="en">
                    <div class="share-header">
                      <span class="share-icon">
                        <Octicon name="share" />
                      </span>
                      <h3>Share</h3>
                    </div>
                    <ul class="share-links">
                      {shareServices.map((service) => (
                        <li>
                          <a
                            href={`${service.share_url_prefix}${encodeURIComponent(pageUrl)}`}
                            title={`Share on ${service.name}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="share-link"
                          >
                            <div class="share-icon" set:html={service.icon_svg} />
                            <span class="share-name">{service.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }

              <div class="article">
                <Content />
              </div>
            </div>
          </article>
        </div>
      </main>
    </div>
  </div>
</Base>

<style is:global>
/* Layout styles carried over unchanged from _layouts/post.html. */
.post-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out;
}

.post-card {
  background: var(--color-surface, #ffffff);
  border-radius: var(--radius-lg, 16px);
  box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  padding: 2.5rem;
  margin-top: 2rem;
}

.content-nav {
  margin-bottom: 2rem;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  color: var(--color-accent, #2563eb);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.nav-link:hover {
  opacity: 0.7;
  text-decoration: none;
}

.nav-icon {
  margin-right: 0.5rem;
}

.post-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--color-border, #e2e8f0);
}

.post-title {
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 1rem;
  letter-spacing: -0.03em;
  color: var(--color-text-primary, #0f172a);
}

.post-meta {
  display: flex;
  align-items: center;
  color: var(--color-text-muted, #94a3b8);
  font-size: 0.95rem;
}

.meta-icon {
  margin-right: 0.5rem;
}

.article-content {
  position: relative;
}

.share-widget {
  position: sticky;
  top: 2rem;
  float: right;
  margin-left: 2rem;
  margin-bottom: 2rem;
  padding: 1.5rem;
  background: var(--color-surface-elevated, #f8fafc);
  border: 1px solid var(--color-border, #e2e8f0);
  border-radius: var(--radius-md, 10px);
  width: 200px;
}

.share-header {
  display: flex;
  align-items: center;
  margin-bottom: 1rem;
  color: var(--color-text-primary);
}

.share-header h3 {
  margin: 0;
  margin-left: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

.share-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.share-link {
  display: flex;
  align-items: center;
  padding: 0.5rem 0;
  color: var(--color-text-secondary, #475569);
  transition: color 0.2s ease;
}

.share-link:hover {
  color: var(--color-accent, #2563eb);
  text-decoration: none;
}

.share-icon {
  width: 24px;
  margin-right: 0.75rem;
}

.share-name {
  font-size: 0.9rem;
}

.article {
  font-size: 1.1rem;
  line-height: 1.8;
  color: var(--color-text-secondary, #475569);
}

.article h2 {
  font-size: 1.75rem;
  font-weight: 600;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
  color: var(--color-text-primary, #0f172a);
}

.article p {
  margin-bottom: 1.5rem;
}

.split-layout {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  padding: 2rem;
  width: 300px;
}

.main-content {
  flex: 1;
  padding: 2.5rem;
  background: var(--color-surface-elevated, #f8fafc);
}

.theme-dark {
  --color-surface: #2d333b;
  --color-surface-elevated: #22272e;
  --color-text-primary: #ffffff;
  --color-text-secondary: rgba(255, 255, 255, 0.85);
  --color-text-muted: rgba(255, 255, 255, 0.5);
  --color-border: rgba(255, 255, 255, 0.1);
  --color-accent: #58a6ff;
}

.theme-dark .post-card {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.theme-dark .share-widget {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .split-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
    position: relative;
  }

  .post-card {
    margin: 1rem 0;
    padding: 1.5rem;
  }

  .post-title {
    font-size: 1.75rem;
  }

  .share-widget {
    float: none;
    width: 100%;
    margin: 0 0 2rem 0;
    position: relative;
    top: 0;
  }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .share-link {
    padding: 0.5rem;
  }
}
</style>
