---
// The front door: who this is, what's new, and where to go from here. The archive lives on /writing/.
import AboutText from "../components/AboutText.astro";
import VisitorMap from "../components/VisitorMap.astro";
import WhatsNew from "../components/WhatsNew.astro";
import { ELSEWHERE } from "../config";
import siteLog from "../data/site-log.json";
import Base from "../layouts/Base.astro";
import { buildDate, later } from "../lib/dates";
import { getProjects } from "../lib/github";
import { pathsLastModified } from "../lib/last-modified.mjs";
import { getPosts } from "../lib/posts";
import { RESUME } from "../lib/resume";
import { homeJsonLd } from "../lib/seo";
import { getWhatsNew } from "../lib/whats-new";

const posts = await getPosts();
const projects = await getProjects();
const today = buildDate();
const whatsNew = getWhatsNew({ posts, projects, siteLog, today });
// The page changes when its own files do, and when What's New gains an entry.
const lastModified = later(
  pathsLastModified(["src/pages/index.astro", "src/components/AboutText.astro", "src/data/site-log.json"]) ?? { date: today, iso: null },
  { date: whatsNew[0]?.date ?? "", iso: null },
);
---

<Base
  title="Xing Liu (刘星) — Home Page"
  ogTitle="Xing Liu’s Home Page"
  description="Xing Liu (刘星) is a Principal ML Solution Architect at Nebius. Notes on LLM inference, books, crypto and life, plus projects and a résumé."
  path="/"
  current="home"
  ogType="website"
  ogKey="home"
  jsonld={homeJsonLd(lastModified)}
  lastModified={lastModified}
>
<div class="hello">
<img class="avatar" src="/avatar-240.jpg" width="120" height="120" alt="Vault Boy badge reading “My mom thinks I’m S.P.E.C.I.A.L.”">
<h1>Xing Liu’s Home Page</h1>
<p class="sub" lang="zh-CN">刘星的个人主页</p>
</div>
<AboutText />
<WhatsNew items={whatsNew} postCount={posts.length} projectCount={projects.length} />
<div class="columns">
<section aria-labelledby="here-h">
<h2 id="here-h">On this site</h2>
<ul>
<li><a href="/writing/">Writing</a> ({posts.length} posts)</li>
<li><a href="/projects/">Projects</a> ({projects.length} repositories)</li>
<li><a href="/about/">About me</a></li>
<li><a href={RESUME.url}>Résumé</a> (PDF, {RESUME.kb}&nbsp;KB)</li>
<li><a href="/writing/#search">Search</a> (English or <span lang="zh-CN" class="nowrap">中文</span>)</li>
</ul>
</section>
<section aria-labelledby="else-h">
<h2 id="else-h">Elsewhere</h2>
<ul>{ELSEWHERE.map((site) => <Fragment>{"\n"}<li><a href={site.url}>{site.name}</a></li></Fragment>)}
<li><a href="/feed.xml">RSS feed</a> (full text)</li>
<li><a href="/about/#colophon">How this site is made</a></li>
</ul>
</section>
</div>
<VisitorMap />
</Base>
