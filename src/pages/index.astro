---
import Base from "../layouts/Base.astro";
import Masthead from "../components/Masthead.astro";
import About from "../components/About.astro";
import Thoughts from "../components/Thoughts.astro";
import Projects from "../components/Projects.astro";
import { VISITOR_MAP_SRC } from "../config";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<Base>
  <div class="home-container" data-layout="sidebar">
    <div class="split-layout">
      <aside class="sidebar bg-gray-dark">
        <Masthead metadata />
      </aside>

      <main class="main-content">
        <div class="content-wrapper">
          <About />

          <div class="sections-grid">
            {posts.length > 0 && <Thoughts posts={posts} />}

            <Projects />
          </div>

          <div class="visitor-counter-wrapper">
            <div class="visitor-counter">
              <script is:inline type="text/javascript" id="mapmyvisitors" src={VISITOR_MAP_SRC}></script>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Base>

<style is:global>
/* Layout styles carried over unchanged from _layouts/home.html. */
.home-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out;
}

.sections-grid {
  display: grid;
  gap: 2.5rem;
  margin: 2rem 0;
}

.split-layout {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  padding: 2rem;
  width: 300px;
}

.main-content {
  flex: 1;
  padding: 2.5rem;
}

.theme-dark {
  background-color: #1a1a1a;
  color: #ffffff;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .split-layout {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
    position: relative;
  }

  .main-content {
    padding: 1.5rem;
  }

  .sections-grid {
    gap: 1.5rem;
  }
}
</style>
