---
// Every public repository the owner has started on GitHub, most recently pushed first: a bevelled
// table on wide screens, one sunken well per repository on phones. The list comes from the GitHub
// API when the site is built, or from the saved snapshot when the API is unreachable, and the line
// under the table says which, and when. The table's explicit roles keep its meaning on phones, where
// Safari would otherwise drop it once the rows are drawn as blocks.
import { GITHUB_USER } from "../../config";
import Base from "../../layouts/Base.astro";
import { buildDate, laDate, later, longDate } from "../../lib/dates";
import { projectsDescription } from "../../lib/descriptions";
import { getGitHubData, getProjects } from "../../lib/github";
import { pathsLastModified } from "../../lib/last-modified.mjs";
import { projectsJsonLd } from "../../lib/seo";

const projects = await getProjects();
const { fetchedAt, live } = await getGitHubData();
const profile = `https://github.com/${GITHUB_USER}`;
const newestPush = projects.find((project) => project.pushed_at)?.pushed_at;
// The page changes when its own files do, and when any repository gets a push.
const lastModified = later(
  pathsLastModified(["src/pages/projects/index.astro", "src/data/repo-notes.json"]) ?? { date: buildDate(), iso: null },
  { date: newestPush ? laDate(newestPush) : "", iso: null },
);

/** A link's text: the address without its scheme or trailing slash. */
const shown = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<Base
  title="Projects — Xing Liu"
  ogTitle="Projects"
  description={projectsDescription(projects)}
  path="/projects/"
  current="projects"
  ogKey="projects"
  jsonld={projectsJsonLd(projects)}
  lastModified={lastModified}
>
<p class="crumbs"><a href="/">Xing Liu’s Home Page</a> › Projects</p>
<h1>Projects</h1>
<p>Every public repository I have started on GitHub, most recently updated first. Forks are left out. The list comes from the GitHub API when the site is built; the date is at the foot of the table.</p>
<div class="table-scroll projects-wrap" role="region" tabindex="0" aria-label="Projects">
<table class="projects" role="table">
<thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Repository</th><th scope="col" role="columnheader">About</th><th scope="col" role="columnheader">Language</th><th scope="col" role="columnheader">Stars</th><th scope="col" role="columnheader">Updated</th></tr></thead>
<tbody role="rowgroup">{projects.map((project) => <Fragment>{"\n"}<tr role="row"><td class="name" role="cell"><a href={project.html_url}><b>{project.name}</b></a></td><td class="about" role="cell"><span class="desc">{project.about ?? <span class="none">No description on GitHub.</span>}</span>{project.homepage && <a class="home" href={project.homepage}>{shown(project.homepage)}</a>}</td><td class="lang" role="cell">{project.language ?? "—"}</td><td class="num" role="cell">{project.stargazers_count}</td><td class="upd" role="cell">{project.pushed_at ? <time datetime={project.pushed_at}>{laDate(project.pushed_at)}</time> : "—"}</td></tr></Fragment>)}
</tbody></table></div>
<p class="small">{live ? `Fetched from api.github.com on ${longDate(laDate(fetchedAt))}.` : `GitHub could not be reached when the site was built, so this list comes from a saved copy made on ${longDate(laDate(fetchedAt))}.`} Forks and everything else are at <a href={profile}>{shown(profile)}</a>.</p>
</Base>
