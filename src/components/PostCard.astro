---
import { formatDate, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<div class="card">
  <div class="card-title">
    <a href={post.url} lang={post.entry.data.lang}>
      {post.entry.data.title}
    </a>
  </div>
  <div class="card-meta">{formatDate(post)}</div>
</div>
