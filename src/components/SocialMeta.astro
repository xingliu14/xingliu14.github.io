---
// Open Graph and Twitter tags: how the page looks when shared. The card image for each page is drawn
// at build time (/og/<key>.png). The Not Found page has none.
interface Props {
  ogType: "website" | "article" | "profile";
  ogKey: string;
  title: string;
  description: string;
  canonical: string;
  lang: "en" | "zh-CN";
  article?: { published: string; modified: string | null; section: string };
}

const { ogType, ogKey, title, description, canonical, lang, article } = Astro.props;
const image = new URL(`/og/${ogKey}.png`, Astro.site).href;
---

<meta property="og:site_name" content="Xing Liu’s Home Page">
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:locale" content={lang === "zh-CN" ? "zh_CN" : "en_US"}>
<meta property="og:image" content={image}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${title}, drawn as a 1997 web page: gray background, Times headline, blue underlined links`}>
<meta name="twitter:card" content="summary_large_image">{
  article && (
    <Fragment>{"\n"}<meta property="article:published_time" content={article.published}>{article.modified && <Fragment>{"\n"}<meta property="article:modified_time" content={article.modified}></Fragment>}{"\n"}<meta property="article:author" content={new URL("/about/", Astro.site).href}>{"\n"}<meta property="article:section" content={article.section}></Fragment>
  )
}{
  ogType === "profile" && (
    <Fragment>{"\n"}<meta property="profile:first_name" content="Xing">{"\n"}<meta property="profile:last_name" content="Liu">{"\n"}<meta property="profile:username" content="xingliu14"></Fragment>
  )
}
