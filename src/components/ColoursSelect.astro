---
// The colour menu. site.js applies and remembers the choice; without scripts it would do nothing,
// so style.css shows it only once the head script has marked <html class="js">.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<select id={id} class="colours"><option value="">Automatic</option><option value="grey">Netscape grey</option><option value="white">Paper white</option><option value="night">Night</option></select>
